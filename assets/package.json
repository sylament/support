{
  "name": "@sylament/support",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js && pnpm build:css",
    "build:js": "esbuild src/**/*.ts --outdir=dist --outbase=src --format=esm --sourcemap=linked",
    "build:css": "tailwindcss -i src/styles/main.css -o dist/styles/main.css --minify",
    "watch": "concurrently -n js,css -c blue,green \"pnpm watch:js\" \"pnpm watch:css\"",
    "watch:js": "esbuild src/**/*.ts --outdir=dist --outbase=src --format=esm --sourcemap=inline --watch=forever",
    "watch:css": "tailwindcss -i src/styles/main.css -o dist/styles/main.css --watch",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "core": {
        "main": "dist/controllers/core_controller.js",
        "fetch": "eager",
        "enabled": true,
        "autoimport": {
          "@sylament/support/styles/main.css": true
        }
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
